# --- 1. Nhân vật chính ---
VITE_BIRTHDAY_NAME=chị Thảo
VITE_BIRTHDAY_GENDER=female
VITE_BIRTHDAY_RELATIONSHIP=colleague
VITE_BIRTHDAY_DATE=2026-08-27T00:00:00
# Để trống nếu không muốn hiện tuổi trên trang
VITE_BIRTHDAY_AGE=
# Tên người gửi — hiện ở cuối thư, dòng ký tên và chân trang
VITE_BIRTHDAY_WISHER_NAME=ACE team MKT

# --- 2. Ngôn ngữ ---
VITE_LANGUAGE=vi

# --- 3. Màu sắc, sở thích, emoji ---
VITE_BIRTHDAY_COLOR=#FFB3A7
VITE_BIRTHDAY_INTERESTS=sport,food,travel
VITE_FAVORITE_EMOJIS=🎂,🥳,🌿,✨,💐

# --- 4. Lời chúc & lá thư ---
VITE_BIRTHDAY_CUSTOM_MESSAGE=Chúc chị một tuổi mới vui vẻ, khỏe mạnh và thật nhiều điều hay ho nhé!
VITE_BIRTHDAY_LETTER_TITLE=Gửi chị Thảo — Leader team MKT
VITE_BIRTHDAY_LETTER_OVERRIDE=Chúc mừng sinh nhật chị Thảo 🎂\n\nChúc chị tuổi mới vẫn giữ vững phong độ ăn healthy, tập Pilates đều đặn và cân bằng cuộc sống tốt hơn cả cách team mình cân deadline 😌\n\nChúc chị luôn thật nhiều năng lượng, công việc suôn sẻ, ít họp hơn, ít việc gấp hơn và có thật nhiều thời gian cho những thứ chị thích.\n\nHappy Birthday chị Thảo — chúc chị một tuổi mới vui vẻ, khỏe mạnh và thật nhiều điều hay ho nhé 🥳

# Tin nhắn cuối mà bạn "gõ" trong khung chat Instagram ở phần intro.
# Để trống thì dùng mẫu mặc định theo mối quan hệ.
VITE_CHAT_MESSAGE=ACE team MKT xin gửi lời chúc mừng sinh nhật đến chị Thảo! 🎂 Cảm ơn chị đã luôn dẫn dắt và cùng tụi em đi qua bao mùa deadline. Chúc chị tuổi mới thật nhiều sức khoẻ, luôn rực rỡ và gặp thật nhiều điều hay ho nhé! 🥳✨

# --- 5. Ảnh ---
# Ảnh nằm trong public/assets/photos/ nên dùng đường dẫn tuyệt đối từ gốc site.
VITE_PHOTO_1=/assets/photos/thao-ao-dai.jpg
VITE_PHOTO_2=/assets/photos/thao-studio-portrait.jpg
VITE_PHOTO_3=/assets/photos/thao-seaside.jpg
VITE_PHOTO_4=/assets/photos/thao-beach.jpg
VITE_PHOTO_5=/assets/photos/thao-family-night.jpg
VITE_PHOTO_CAPTIONS=Rạng rỡ và duyên dáng đúng chất chị Thảo 🌸|Khí chất leader không lẫn vào đâu được ✨|Những chuyến đi chữa lành 🌊|Biển, gió và một ngày thật thảnh thơi ☀️|Gia đình nhỏ, hạnh phúc to 💛

# --- 6. Kỷ niệm đặc biệt (mục Final Surprise) ---
VITE_SPECIAL_MEMORIES=Người leader của team MKT;/assets/photos/thao-studio-portrait.jpg|Một năm mới thật nhiều năng lượng;/assets/photos/thao-ao-dai.jpg

# --- 7. Âm thanh ---
# Nhạc nền cho trang landing cuối (KHÔNG phát ở các màn intro đầu).
