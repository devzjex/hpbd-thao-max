# Hermetic defaults for the test suite.
#
# Vite loads `.env.[mode]` with higher precedence than `.env`, and Vitest runs in
# mode "test" — so these values shadow whatever personal `.env` a developer keeps
# locally. Without this, a configured `.env` (name, language, photos, music) leaks
# into `import.meta.env` at module load and flips assertions that expect defaults.
#
# Tests that need a specific configuration should stub `import.meta.env` themselves.

VITE_BIRTHDAY_NAME=
VITE_BIRTHDAY_AGE=
VITE_BIRTHDAY_GENDER=
VITE_BIRTHDAY_DATE=
VITE_BIRTHDAY_RELATIONSHIP=
VITE_BIRTHDAY_WISHER_NAME=

VITE_LANGUAGE=en
VITE_LANG=

VITE_BIRTHDAY_COLOR=
VITE_BIRTHDAY_INTERESTS=
VITE_FAVORITE_EMOJIS=

VITE_BIRTHDAY_CUSTOM_MESSAGE=
VITE_BIRTHDAY_LETTER_TITLE=
VITE_BIRTHDAY_LETTER_OVERRIDE=
VITE_SPECIAL_MEMORIES=

VITE_PHOTOS=
VITE_PHOTO_1=
VITE_PHOTO_2=
VITE_PHOTO_3=
VITE_PHOTO_4=
VITE_PHOTO_5=
VITE_PHOTO_6=
VITE_PHOTO_CAPTIONS=

VITE_YOUTUBE_BGM_URL=
VITE_YOUTUBE_BGM_ID=
VITE_BGM_URL=

VITE_PASSWORD_REQUIRED=
VITE_PASSWORD=
VITE_FAMILY_RELATIONSHIP_LABEL=
